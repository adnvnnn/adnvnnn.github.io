@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model IndexModel
@{
    var site = Model.Site;
    var owner = site.Owner;
    var active = Model.ActivePage == "profile";
    var resumeExists = !string.IsNullOrWhiteSpace(owner.ResumeUrl)
        && Env.WebRootFileProvider.GetFileInfo(owner.ResumeUrl).Exists;
}
<section class="page page--profile" id="page-profile" data-page="profile" aria-labelledby="profile-title"
         hidden="@(active ? null : "hidden")" inert="@(active ? null : "inert")">

    <h1 class="page__title" id="profile-title">Profile</h1>

    <div class="hero hero--profile glass-host" data-glass="card">
        <div class="hero__text">
            <h2 class="hero__name">
                <span class="hero__first">@owner.FirstName</span>
                <span class="hero__last">@owner.LastName</span>
            </h2>
            <p class="hero__role">@owner.Role</p>
            <p class="hero__bio">@owner.Bio</p>
            @if (resumeExists)
            {
                <a class="btn btn--primary btn--md" href="@Url.Content("~" + owner.ResumeUrl)" download><span>Download Resume</span></a>
            }
            else
            {
                <button class="btn btn--primary btn--md" type="button" data-toast="The resume file hasn’t been added yet."><span>Download Resume</span></button>
            }
        </div>
        <img class="hero__portrait" src="~/assets/img/portrait-front.webp" asp-append-version="true"
             alt="Portrait of @owner.FullName" width="356" height="406" decoding="async" />
    </div>

    <h2 class="label label--skills">Skills</h2>

    <div class="tray glass-host" data-glass="tray">
        <ul class="tiles">
            @foreach (var skill in site.Skills)
            {
                <li class="tile glass-host" data-glass="tile" style="--level:@skill.Level">
                    <span class="tile__liquid" aria-hidden="true"></span>
                    <span class="tile__name">@skill.Name</span>
                    <span class="tile__pct">@skill.Level %</span>
                </li>
            }
        </ul>
    </div>
</section>
