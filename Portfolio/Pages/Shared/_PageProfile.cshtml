@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model IndexModel
@{
    var site = Model.Site;
    var owner = site.Owner;
    var active = Model.ActivePage == "profile";
    var resumeExists = !string.IsNullOrWhiteSpace(owner.ResumeUrl)
        && Env.WebRootFileProvider.GetFileInfo(owner.ResumeUrl).Exists;
}
<section class="page page--profile" id="page-profile" data-page="profile" aria-labelledby="profile-title"
         hidden="@(active ? null : "hidden")" inert="@(active ? null : "inert")">

    <h1 class="page__title" id="profile-title">Profile</h1>

    <div class="hero hero--profile glass-host" data-glass="card">
        <div class="hero__text">
            <h2 class="hero__name">
                <span class="hero__first">@owner.FirstName</span>
                <span class="hero__last">@owner.LastName</span>
            </h2>
            <p class="hero__role">@owner.Role</p>
            <p class="hero__bio">@owner.Bio</p>
            @if (resumeExists)
            {
                <a class="btn btn--primary btn--md" href="@Url.Content("~" + owner.ResumeUrl)" download><span>Download Resume</span></a>
            }
            else
            {
                <button class="btn btn--primary btn--md" type="button" data-toast="The resume file hasn’t been added yet."><span>Download Resume</span></button>
            }
        </div>
        <img class="hero__portrait" src="~/assets/img/portrait-front.webp" asp-append-version="true"
             alt="Portrait of @owner.FullName" width="356" height="406" decoding="async" />
    </div>

    <h2 class="label label--skills">Skills</h2>

    <div class="tray glass-host" data-glass="tray">
        @* Only the desktop artboard scrolls its row (a tray holds six tiles at design size). profile.js enables the arrows when it overflows. *@
        <button class="tray__nav tray__nav--prev" type="button" aria-label="Scroll skills left" disabled>@Html.Icon("chevron-left")</button>
        <ul class="tiles">
            @for (var i = 0; i < site.Skills.Count; i++)
            {
                var skill = site.Skills[i];
                var hasTip = !string.IsNullOrWhiteSpace(skill.Description);
                @* With a description the tile swaps its face on hover/focus (see .tile--info in profile.css); tabindex lets a keyboard or a tap reach it. *@
                <li class="@(hasTip ? "tile tile--info glass-host" : "tile glass-host")" data-glass="tile" style="--level:@skill.Level"
                    tabindex="@(hasTip ? "0" : null)">
                    @* The liquid is inline SVG (one tile = the 156 × 154 viewBox) so CSS can animate its parts: see .liquid__* in profile.css.
                       The wave period below (202.8) must match --wave-w there. *@
                    <svg class="tile__liquid" viewBox="0 0 156 154" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <defs>
                            <linearGradient id="liquid-fill-@i" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="156" y2="0">
                                <stop class="liquid__from" offset="0.0265" />
                                <stop class="liquid__to" offset="1" />
                            </linearGradient>
                            <clipPath id="liquid-wave-@i">
                                <path d="M0 12Q50.7 0 101.4 12T202.8 12T304.2 12T405.6 12V200H0Z" />
                            </clipPath>
                        </defs>
                        <g class="liquid__level">
                            <g class="liquid__wave" clip-path="url(#liquid-wave-@i)">
                                <rect class="liquid__fill" width="156" height="200" fill="url(#liquid-fill-@i)" />
                            </g>
                        </g>
                    </svg>
                    <span class="tile__name">@skill.Name</span>
                    <span class="tile__pct">@skill.Level %</span>
                    @if (hasTip)
                    {
                        <span class="tile__desc">@skill.Description</span>
                    }
                </li>
            }
        </ul>
        <button class="tray__nav tray__nav--next" type="button" aria-label="Scroll skills right" disabled>@Html.Icon("chevron-right")</button>
    </div>
</section>
