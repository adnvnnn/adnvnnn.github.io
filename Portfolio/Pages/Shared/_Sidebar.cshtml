@model IndexModel
@{
    // key, url, label (kept exactly as designed), icon
    var items = new (string Key, string Href, string Label, string Icon)[]
    {
        ("home", "/", "Home", "home"),
        ("profile", "/profile", "Profile", "user"),
        ("projects", "/projects", "projects", "grid"),
        ("contact", "/contact", "Contact", "call")
    };
}
<aside class="sidebar glass-host" data-glass="sidebar">
    <p class="sidebar__brand">Explore</p>

    <nav class="nav" aria-label="Primary">
        <span class="nav__pill" aria-hidden="true"></span>
        <ul class="nav__list">
            @foreach (var item in items)
            {
                var active = Model.ActivePage == item.Key;
                <li>
                    <a class="nav__link@(active ? " is-active" : "")" href="@Url.Content("~" + item.Href)" data-page="@item.Key"
                       data-title="@Model.TitleFor(item.Key)" aria-current="@(active ? "page" : null)">
                        @Html.Icon(item.Icon, "nav__icon")
                        <span class="nav__label">@item.Label</span>
                    </a>
                </li>
            }
        </ul>
    </nav>

    <p class="sidebar__copy">Copyright © @Model.Site.Owner.CopyrightYear - @Model.Site.Owner.FullName</p>
</aside>
