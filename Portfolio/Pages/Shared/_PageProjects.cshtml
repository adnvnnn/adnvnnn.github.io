@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model IndexModel
@inject IFileVersionProvider FileVersions
@{
    var site = Model.Site;
    var featured = site.Projects.FirstOrDefault();
    var active = Model.ActivePage == "projects";
    // The carousel script builds its slides from this data, so it gets the same content-hashed URLs the
    // tag helper puts on the markup: an image the page already loaded is reused, and a replaced file is
    // never served stale from the one-hour cache of the plain URL.
    string Versioned(string path) => path.StartsWith('/') ? FileVersions.AddFileVersionToPath(Context.Request.PathBase, path) : path;
    var json = JsonSerializer.Serialize(site.Projects.Select(p => new
    {
        id = p.Id,
        title = p.Title,
        summary = p.Summary,
        categories = p.Categories,
        tags = p.Tags,
        images = p.Slides.Select(Versioned),
        liveUrl = p.LiveUrl,
        sourceUrl = p.SourceUrl
    }), new JsonSerializerOptions(JsonSerializerDefaults.Web));
}
<section class="page page--projects" id="page-projects" data-page="projects" aria-labelledby="projects-title"
         hidden="@(active ? null : "hidden")" inert="@(active ? null : "inert")">

    <h1 class="page__title" id="projects-title">Projects</h1>
    <p class="page__sub">selected work that solve problems and deliver impact</p>

    @if (featured is not null)
    {
        <h2 class="label label--featured">Featured Project</h2>

        <article class="featured glass-host" data-glass="card" data-featured="@featured.Id">
            <div class="featured__info">
                <h3 class="featured__title">@featured.Title</h3>
                <p class="featured__text">@featured.Summary</p>
                <ul class="tags">
                    @foreach (var tag in featured.Tags)
                    {
                        <li class="tag">@tag</li>
                    }
                </ul>
                <div class="featured__actions">
                    <a class="btn btn--primary btn--sm" data-role="live" href="@featured.LiveUrl" target="_blank" rel="noopener noreferrer">Live Demo</a>
                    <a class="btn btn--white btn--sm" data-role="source" href="@featured.SourceUrl" target="_blank" rel="noopener noreferrer">
                        source code @Html.Icon("github", "btn__icon")
                    </a>
                </div>
            </div>

            <div class="featured__media carousel" data-carousel aria-roledescription="carousel" aria-label="Project screenshots">
                <ul class="carousel__track">
                    @{ var slideNumber = 0; }
                    @foreach (var slide in featured.Slides)
                    {
                        slideNumber++;
                        <li class="carousel__slide" aria-roledescription="slide" aria-label="@slideNumber of @featured.Slides.Count">
                            <img src="@slide" asp-append-version="true" alt="@featured.Title screenshot @slideNumber" width="1586" height="889"
                                 loading="@(slideNumber == 1 ? "eager" : "lazy")" decoding="async" draggable="false" />
                        </li>
                    }
                </ul>
                <button class="carousel__nav carousel__nav--prev" type="button" aria-label="Previous image">@Html.Icon("chevron-left")</button>
                <button class="carousel__nav carousel__nav--next" type="button" aria-label="Next image">@Html.Icon("chevron-right")</button>
                <div class="carousel__dots" role="group" aria-label="Choose image"></div>
            </div>
        </article>
    }

    <div class="plist-head">
        <h2 class="label label--all">All Projects</h2>
        <div class="chips" role="group" aria-label="Filter projects">
            @foreach (var filter in site.ProjectFilters)
            {
                var isAll = string.Equals(filter, "All", StringComparison.OrdinalIgnoreCase);
                <button class="chip@(isAll ? " is-active" : "")" type="button" data-filter="@filter" aria-pressed="@(isAll ? "true" : "false")">@filter</button>
            }
        </div>
    </div>

    <div class="plist" data-plist>
        <button class="plist__nav plist__nav--prev" type="button" aria-label="Scroll projects left">@Html.Icon("chevron-left")</button>
        <ul class="plist__track">
            @foreach (var project in site.Projects)
            {
                var isFeatured = featured is not null && project.Id == featured.Id;
                <li class="plist__item" data-category="@string.Join('|', project.Categories)">
                    <button class="pcard@(isFeatured ? " is-selected" : "")" type="button" data-project="@project.Id"
                            aria-pressed="@(isFeatured ? "true" : "false")">
                        <img class="pcard__img" src="@project.Cover" asp-append-version="true" alt="" width="763" height="580"
                             loading="lazy" decoding="async" draggable="false" />
                        <span class="pcard__title">@project.Title</span>
                        @Html.Icon("arrow-up-right", "pcard__arrow")
                    </button>
                </li>
            }
        </ul>
        <button class="plist__nav plist__nav--next" type="button" aria-label="Scroll projects right">@Html.Icon("chevron-right")</button>
    </div>

    <script type="application/json" id="projects-data">@Html.Raw(json)</script>
</section>
