@using Portfolio.ConfigModels
@{
    var projects = ProjectsConfigModel.Items ?? new List<ProjectItem>();
    var categories = CategoriesConfigModel.Items ?? new List<CategoryItem>();
}
<section id="projects" class="section" data-title="Projects" data-subtitle="selected work that solve problems and deliver impact">
    <div class="content">
        <div class="featured-section">
            <h3>Featured Project</h3>
            <div class="featured-card">
                <div class="featured-info">
                    <h2>Plantiful</h2>
                    <p>Modern website for the users to have a way of sharing the nurturing journey of their plants</p>
                    <div class="tech-tags">
                        <span class="tech-tag">Typescript</span>
                        <span class="tech-tag">tailwind css</span>
                        <span class="tech-tag">next.js</span>
                    </div>
                    <div class="featured-actions">
                        <button class="btn-demo">Live Demo</button>
                        <button class="btn-source">source code ⌨</button>
                    </div>
                </div>
                <div class="featured-img">🌿</div>
            </div>
        </div>

        <div class="all-projects-header">
            <h3>All Projects</h3>
            <div class="filter-tabs">
                <button class="filter-tab active" data-filter="All">All</button>
                @foreach (var category in categories)
                {
                    <button class="filter-tab" data-filter="@category.Id">@category.Name</button>
                }
            </div>
        </div>

        <div class="project-grid-wrapper">
            <button type="button" class="proj-arrow prev" aria-label="Previous projects">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <div class="project-grid">
                @for (var i = 0; i < projects.Count; i++)
                {
                    var project = projects[i];
                    var href = string.IsNullOrEmpty(project.Link) ? "#" : project.Link;
                    var categoryIds = string.Join(",", project.CategoryIds ?? new List<int>());
                    <a class="project-card" href="@href" title="@project.Description" data-category="@categoryIds" draggable="false">
                        <div class="card-bg" style="background-image:url(@project.Image)"></div>
                        <div class="card-overlay"></div>
                        <div class="card-label">@project.Title</div>
                        <div class="card-arrow">↗</div>
                    </a>
                }
            </div>
            <button type="button" class="proj-arrow next" aria-label="Next projects">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
    </div>
</section>
