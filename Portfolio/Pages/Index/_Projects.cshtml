@using Portfolio.ConfigModels
@using System.Text.Json
@{
    var projects = ProjectsConfigModel.Items ?? new List<ProjectItem>();
    var categories = CategoriesConfigModel.Items ?? new List<CategoryItem>();

    List<string> BuildImages(ProjectItem p)
    {
        var images = new List<string>();
        if (!string.IsNullOrEmpty(p.Image)) images.Add(p.Image!);
        if (p.OtherImages != null) images.AddRange(p.OtherImages.Where(i => !string.IsNullOrEmpty(i))!);
        return images;
    }

    string BuildPayload(ProjectItem p)
    {
        return JsonSerializer.Serialize(new
        {
            title = p.Title,
            description = p.Description,
            tags = p.Tags ?? new List<string>(),
            images = BuildImages(p),
            link = p.Link,
            sourceLink = p.SourceLink
        });
    }

    var featuredProject = projects.FirstOrDefault();
    var featuredImages = featuredProject != null ? BuildImages(featuredProject) : new List<string>();
    var featuredTags = featuredProject?.Tags ?? new List<string>();
}
<section id="projects" class="section" data-title="Projects" data-subtitle="selected work that solve problems and deliver impact">
    <div class="content">
        <div class="featured-section">
            <h3>Featured Project</h3>
            <div class="featured-card">
                <div class="featured-info">
                    <h2 id="featuredTitle">@featuredProject?.Title</h2>
                    <p id="featuredDesc">@featuredProject?.Description</p>
                    <div class="tech-tags" id="featuredTags" style="@(featuredTags.Count == 0 ? "display:none" : "")">
                        @foreach (var tag in featuredTags)
                        {
                            <span class="tech-tag">@tag</span>
                        }
                    </div>
                    <div class="featured-actions">
                        <button class="btn-demo" id="featuredDemoBtn" data-link="@featuredProject?.Link" style="@(string.IsNullOrEmpty(featuredProject?.Link) ? "display:none" : "")">Live Demo</button>
                        <button class="btn-source" id="featuredSourceBtn" data-link="@featuredProject?.SourceLink" style="@(string.IsNullOrEmpty(featuredProject?.SourceLink) ? "display:none" : "")">source code ⌨</button>
                    </div>
                </div>
                <div class="featured-img" id="featuredSlider">
                    @if (featuredImages.Count > 1)
                    {
                        <button type="button" class="featured-arrow prev" aria-label="Previous image">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                    }
                    <div class="featured-slides">
                        @if (featuredImages.Count > 0)
                        {
                            for (var i = 0; i < featuredImages.Count; i++)
                            {
                                <img class="featured-slide @(i == 0 ? "active" : "")" src="@featuredImages[i]" alt="@featuredProject!.Title" />
                            }
                        }
                        else
                        {
                            <span class="featured-img-fallback">🌿</span>
                        }
                    </div>
                    @if (featuredImages.Count > 1)
                    {
                        <button type="button" class="featured-arrow next" aria-label="Next image">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                        <div class="featured-slider-dots">
                            @for (var i = 0; i < featuredImages.Count; i++)
                            {
                                <button type="button" class="featured-dot @(i == 0 ? "active" : "")" data-index="@i" aria-label="Show image @(i + 1)"></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="all-projects-header">
            <h3>All Projects</h3>
            <div class="filter-tabs">
                <button class="filter-tab active" data-filter="All">All</button>
                @foreach (var category in categories)
                {
                    <button class="filter-tab" data-filter="@category.Id">@category.Name</button>
                }
            </div>
        </div>

        <div class="project-grid-wrapper">
            <button type="button" class="proj-arrow prev" aria-label="Previous projects">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <div class="project-grid">
                @for (var i = 0; i < projects.Count; i++)
                {
                    var project = projects[i];
                    var categoryIds = string.Join(",", project.CategoryIds ?? new List<int>());
                    <a class="project-card @(i == 0 ? "active-featured" : "")" href="#" title="@project.Description" data-category="@categoryIds" data-project="@BuildPayload(project)" draggable="false">
                        <div class="card-bg" style="background-image:url(@project.Image)"></div>
                        <div class="card-overlay"></div>
                        <div class="card-label">@project.Title</div>
                        <div class="card-arrow">↗</div>
                    </a>
                }
            </div>
            <button type="button" class="proj-arrow next" aria-label="Next projects">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
    </div>
</section>
