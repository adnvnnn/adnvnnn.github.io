        <div class="message-card glass-card-bg">
            <h2>@Localizer["Contact_SendTitle"]</h2>
            <div class="form-group"><label>@Localizer["Contact_NameLabel"]</label><input class="glass-pill-fill" type="text" placeholder="@Localizer["Contact_NamePlaceholder"]" /></div>
            <div class="form-group"><label>@Localizer["Contact_EmailFieldLabel"]</label><input class="glass-pill-fill" type="email" placeholder="@Localizer["Contact_EmailPlaceholder"]" /></div>
            <div class="form-group"><label>@Localizer["Contact_SubjectLabel"]</label><input class="glass-pill-fill" type="text" placeholder="@Localizer["Contact_SubjectPlaceholder"]" /></div>
            <div class="form-group"><label>@Localizer["Contact_MessageLabel"]</label><textarea class="glass-pill-fill" rows="4" placeholder="@Localizer["Contact_MessagePlaceholder"]"></textarea></div>
