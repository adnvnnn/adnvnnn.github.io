@using Portfolio.ConfigModels
<section id="profile" class="section" data-title="Profile">

    <div class="content">
        <div class="profile-hero">
            <div class="profile-hero-text">
                <h2>
                    @InfoConfigModel.FirstName 

                    <span>
                        @InfoConfigModel.LastName
                    </span>
                </h2>
                <div class="subtitle">Full-Stack Developer crafting digital experiences</div>
                <p>
                    I turn ideas into digital products through thoughtful design and clean, efficient code.Currently focused on web development, software architecture, and creating great user experiences.I turn ideas into digital products through thoughtful design and clean, efficient code.Currently focused on web development, software architecture, and creating great user experiences.
                </p>
                <button class="btn-resume">⬇ Download Resume</button>
            </div>
            <img class="profile-avatar" src="assets/images/front.png" />
        </div>
        <div class="skills-h3">Skills</div>
        <div class="skill-bubbles">
            <div class="skill-bubble"><div class="bubble-fill" style="height:85%"></div><div class="bubble-name">Python</div><div class="bubble-pct">85%</div></div>
            <div class="skill-bubble"><div class="bubble-fill" style="height:70%"></div><div class="bubble-name">CSS3</div><div class="bubble-pct">70%</div></div>
            <div class="skill-bubble"><div class="bubble-fill" style="height:35%"></div><div class="bubble-name">Java</div><div class="bubble-pct">35%</div></div>
            <div class="skill-bubble"><div class="bubble-fill" style="height:90%"></div><div class="bubble-name">Python</div><div class="bubble-pct">90%</div></div>
            <div class="skill-bubble"><div class="bubble-fill" style="height:30%"></div><div class="bubble-name">CSS3</div><div class="bubble-pct">30%</div></div>
            <div class="skill-bubble"><div class="bubble-fill" style="height:97%"></div><div class="bubble-name">Java</div><div class="bubble-pct">97%</div></div>
        </div>
    </div>
</section>
