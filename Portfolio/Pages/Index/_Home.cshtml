@using Portfolio.ConfigModels
@{
    var lastProject = ProjectsConfigModel.Items!.Last();
}
<section id="home" class="section active" data-title="@Localizer["Nav_Home"]">
    <div class="content">
        <div class="hero-card">
            <div class="hero-text">
                <h1>@InfoConfigModel.FirstName</h1>
                <p>@Localizer["Common_FullStackTagline"]</p>
                <div class="hero-status"><div class="dot-green"></div> @Localizer["Common_ReadyForFreelancing"]</div>
            </div>
            <img class="hero-avatar" src="assets/images/side.png" />

        </div>

        <div class="home-row">
            <div class="bio-card">@Localizer["Common_Bio"]</div>
            <div class="cta-group">
                <button class="btn-primary" onclick="navigate('contact')">@Localizer["Home_HireMe"]</button>
                <button class="btn-outline" onclick="navigate('projects')">@Localizer["Home_ProjectsButton"]</button>
            </div>
        </div>

        <div class="home-bottom">
            <div class="skills-card">
                <h3>@Localizer["Common_SkillsTitle"]</h3>
                <div class="skill-row">
                    <div class="skill-fill" style="width:70%"></div>
                    <span class="skill-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6" />
                            <path d="M7 9l3 3-3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            <line x1="13" y1="15" x2="17" y2="15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </span><span class="skill-name">@Localizer["Common_SkillPython"]</span><span class="skill-pct">70%</span>
                </div>
                <div class="skill-row">
                    <div class="skill-fill" style="width:85%"></div>
                    <span class="skill-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3a9 9 0 100 18c1.5 0 2-1 2-2s-.5-1.5-.5-2.5S14.5 15 16 15h1a4 4 0 004-4c0-4.4-4-8-9-8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            <circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" />
                            <circle cx="11" cy="7.5" r="1.2" fill="currentColor" />
                            <circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" />
                        </svg>
                    </span><span class="skill-name">@Localizer["Common_SkillCss"]</span><span class="skill-pct">85%</span>
                </div>
                <div class="skill-row">
                    <div class="skill-fill" style="width:45%"></div>
                    <span class="skill-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 8h13v6a5 5 0 01-5 5H9a5 5 0 01-5-5V8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            <path d="M17 10h1.5a2.5 2.5 0 010 5H17" stroke="currentColor" stroke-width="1.6" />
                            <path d="M8 4c-.5.8-.5 1.2 0 2M12 4c-.5.8-.5 1.2 0 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </span><span class="skill-name">@Localizer["Common_SkillJava"]</span><span class="skill-pct">45%</span>
                </div>
            </div>
            <div class="latest-project" onclick="navigate('projects')">
                <img class="proj-bg" src="@lastProject.Image" />
                <div class="proj-label">
                    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 22c4.5 0 7-3 7-6.5 0-2.5-1.2-4.2-2.4-5.8-.6 1.6-1.6 2.3-2.1 2.3.5-3-1-5.5-3-7 0 2-1 3.3-2.4 4.7C7.6 11.2 6 12.8 6 15.5 6 19 8.5 22 12 22z" />
                    </svg>
                    @Localizer["Home_LatestProject"]
                </div>
            </div>
            <div class="socials-col">
                <a class="social-btn" href="#" title="@Localizer["Common_GitHub"]">
                    <svg xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" viewBox="0 0 512 499.368"><path fill="#fff" fill-rule="nonzero" d="M256.003 0C114.555 0 0 114.555 0 256.003c0 113.286 73.28 208.961 175.038 242.865 12.796 2.247 17.586-5.433 17.586-12.153 0-6.077-.309-26.225-.309-47.686-64.313 11.844-80.941-15.674-86.058-30.055-2.896-7.37-15.359-30.1-26.269-36.177-8.948-4.808-21.752-16.652-.31-16.961 20.168-.309 34.574 18.564 39.382 26.244 23.038 38.732 59.839 27.828 74.555 21.101 2.227-16.627 8.947-27.828 16.318-34.239-56.968-6.386-116.467-28.471-116.467-126.399 0-27.827 9.907-50.866 26.225-68.787-2.562-6.41-11.51-32.655 2.562-67.853 0 0 21.436-6.72 70.409 26.244 20.483-5.767 42.227-8.638 63.998-8.638 21.751 0 43.52 2.896 63.997 8.638 48.973-33.279 70.39-26.244 70.39-26.244 14.09 35.192 5.117 61.443 2.562 67.853 16.318 17.921 26.244 40.625 26.244 68.787 0 98.237-59.84 119.988-116.801 126.399 9.282 8.014 17.277 23.373 17.277 47.371 0 34.238-.309 61.751-.309 70.389 0 6.721 4.808 14.735 17.586 12.179C438.739 464.964 512 368.955 512 256.003 512 114.555 397.445 0 256.003 0z" /></svg>
                </a>
                <a class="social-btn" href="#" title="@Localizer["Common_LinkedIn"]">
                    <svg xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" viewBox="0 0 512 512"><path fill="#fff" d="M474.919 0H38.592C17.72 0 0 16.504 0 36.841V475.14C0 495.496 11.629 512 32.492 512h436.327C489.718 512 512 495.496 512 475.14V36.841C512 16.504 495.809 0 474.919 0zM195.043 195.043h68.928v35.136h.755c10.505-18.945 41.541-38.177 79.921-38.177 73.655 0 94.214 39.108 94.214 111.538v135.321h-73.148V316.883c0-32.427-12.947-60.883-43.227-60.883-36.768 0-54.295 24.889-54.295 65.758v117.103h-73.148V195.043zM73.139 438.861h73.148V195.043H73.139v243.818zm82.289-329.148c0 25.258-20.457 45.715-45.715 45.715-25.258 0-45.715-20.457-45.715-45.715 0-25.258 20.457-45.715 45.715-45.715 25.258 0 45.715 20.457 45.715 45.715z" /></svg>
                </a>
                <a class="social-btn" href="#" title="@Localizer["Common_Telegram"]">
                    <svg xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" viewBox="0 0 512 512"><path fill="#fff" d="M512 256C512 114.62 397.38 0 256 0S0 114.62 0 256s114.62 256 256 256 256-114.62 256-256zm-396.12-2.7c74.63-32.52 124.39-53.95 149.29-64.31 71.1-29.57 85.87-34.71 95.5-34.88 2.12-.03 6.85.49 9.92 2.98 2.59 2.1 3.3 4.94 3.64 6.93.34 2 .77 6.53.43 10.08-3.85 40.48-20.52 138.71-29 184.05-3.59 19.19-10.66 25.62-17.5 26.25-14.86 1.37-26.15-9.83-40.55-19.27-22.53-14.76-35.26-23.96-57.13-38.37-25.28-16.66-8.89-25.81 5.51-40.77 3.77-3.92 69.27-63.5 70.54-68.9.16-.68.31-3.2-1.19-4.53s-3.71-.87-5.3-.51c-2.26.51-38.25 24.3-107.98 71.37-10.22 7.02-19.48 10.43-27.77 10.26-9.14-.2-26.72-5.17-39.79-9.42-16.03-5.21-28.77-7.97-27.66-16.82.57-4.61 6.92-9.32 19.04-14.14z" /></svg>
                </a>
            </div>
        </div>
    </div>
</section>
